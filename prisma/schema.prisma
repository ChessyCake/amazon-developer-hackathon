datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PlanStatus {
  DRAFT
  PROPOSED
  ACTIVE
  COMPLETED
  SUPERSEDED
  REJECTED
  ARCHIVED
}

enum PlanItemType {
  TASK
  EVENT
  BREAK
  BUFFER
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MilestoneStatus {
  PENDING
  COMPLETED
}

enum RecurrenceFrequency {
  DAILY
  WEEKDAYS
  WEEKLY
  CUSTOM
}

enum FocusSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  timezone       String           @default("Asia/Kolkata")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tasks          Task[]
  calendarEvents CalendarEvent[]
  preferences    UserPreference?
  plans          Plan[]
  actionHistory  ActionHistory[]
  conversations  Conversation[]
  goals          Goal[]
  recurringRules RecurringRule[]
  focusSessions  FocusSession[]

  @@map("users")
}

model Task {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  duration        Int            @default(30)
  priority        TaskPriority   @default(MEDIUM)
  deadline        DateTime?
  status          TaskStatus     @default(PENDING)
  tags            String[]       @default([])
  dependencies    String[]       @default([])
  allowSplitting  Boolean        @default(false)
  completedAt     DateTime?
  goalId          String?
  goal            Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId     String?
  milestone       Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  recurrenceDate  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  planItems       PlanItem[]
  focusSessions   FocusSession[]

  @@unique([recurringRuleId, recurrenceDate])
  @@index([userId, status])
  @@index([userId, deadline])
  @@index([userId, goalId])
  @@map("tasks")
}

model CalendarEvent {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean    @default(false)
  location    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  planItems   PlanItem[]

  @@index([userId, startTime, endTime])
  @@map("calendar_events")
}

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusMinutes  Int      @default(45)
  breakMinutes  Int      @default(10)
  workStartTime String   @default("09:00")
  workEndTime   String   @default("18:00")
  bufferMinutes Int      @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_preferences")
}

model Plan {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String
  status       PlanStatus @default(DRAFT)
  version      Int        @default(1)
  parentPlanId String?
  replanReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        PlanItem[]

  @@unique([userId, date, version])
  @@index([userId, date, status])
  @@map("plans")
}

model PlanItem {
  id              String         @id @default(cuid())
  planId          String
  plan            Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemType        PlanItemType
  title           String
  startTime       DateTime
  endTime         DateTime
  order           Int
  isCompleted     Boolean        @default(false)
  isPinned        Boolean        @default(false)
  part            Int?
  totalParts      Int?
  taskId          String?
  task            Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  calendarEventId String?
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([planId, order])
  @@map("plan_items")
}

model ActionHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, entityType, entityId])
  @@map("action_history")
}

model Conversation {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  messages  ConversationMessage[]

  @@index([userId, createdAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String?
  toolCalls      Json?
  toolCallId     String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model Goal {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?
  status      GoalStatus    @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  milestones  Milestone[]
  tasks       Task[]

  @@index([userId, status])
  @@map("goals")
}

model Milestone {
  id          String          @id @default(cuid())
  goalId      String
  goal        Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?
  order       Int             @default(0)
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tasks       Task[]

  @@index([goalId, order])
  @@map("milestones")
}

model RecurringRule {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  duration    Int                 @default(30)
  priority    TaskPriority        @default(MEDIUM)
  frequency   RecurrenceFrequency @default(DAILY)
  daysOfWeek  Int[]               @default([])
  tags        String[]            @default([])
  startDate   DateTime            @default(now())
  endDate     DateTime?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tasks       Task[]

  @@index([userId, isActive])
  @@map("recurring_rules")
}

model FocusSession {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId             String?
  task               Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  startTime          DateTime           @default(now())
  endTime            DateTime?
  durationMinutes    Int?
  interruptionsCount Int                @default(0)
  notes              String?
  status             FocusSessionStatus @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId, status])
  @@map("focus_sessions")
}

