# Server & Network Configuration
PORT=3000
NODE_ENV=production
# BACKEND_INTERNAL_URL="http://localhost:3000"
# NEXT_PUBLIC_API_URL="https://your-domain.up.railway.app"

# PostgreSQL Connection String
# Local Docker / Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos?schema=public"
# Remote Managed Postgres (Neon / Supabase / AWS RDS):
DATABASE_URL="postgresql://user:password@ep-name-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30"

# Default Demo User
DEMO_USER_ID="demo-user-001"
DEMO_USER_EMAIL="demo@lifeos.local"
DEFAULT_TIMEZONE="Asia/Kolkata"

# LLM Configuration (Options: "gemini", "openai", "mock")
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# Optional OpenAI or compatible provider
# OPENAI_API_KEY="your-openai-api-key"
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"

