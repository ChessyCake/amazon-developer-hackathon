# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Connection String (format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos?schema=public"

# Default Demo User
DEMO_USER_ID="demo-user-001"
DEMO_USER_EMAIL="demo@lifeos.local"
DEFAULT_TIMEZONE="Asia/Kolkata"

# Stage 3 LLM Configuration (Options: "gemini", "openai", "mock")
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# Optional OpenAI or compatible provider
# OPENAI_API_KEY="your-openai-api-key"
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"

